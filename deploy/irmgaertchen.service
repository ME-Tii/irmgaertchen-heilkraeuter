# Systemd-Unit für den Irmgärtchen-Shop (gunicorn)
# Nach /etc/systemd/system/irmgaertchen.service kopieren:
#   sudo cp deploy/irmgaertchen.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now irmgaertchen
#
# Wichtig: Die Datei server/.env wird vom Backend selbst geladen
# (STRIPE_SECRET_KEY, DOMAIN, IRM_ADMIN_USERNAME, IRM_ADMIN_PASSWORD, ...).

[Unit]
Description=Irmgaertchen Heilkrauter Shop (Flask/gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/thomasseitz22/irmgaertchen-shop/server
ExecStart=/home/thomasseitz22/irmgaertchen-shop/server/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:5000 \
    --timeout 60 \
    server:app
Restart=always
RestartSec=5
# Falls kein .venv genutzt wird, stattdessen:
# ExecStart=/usr/local/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 server:app
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
