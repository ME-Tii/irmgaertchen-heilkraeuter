# Stripe secret key (Test: sk_test_..., Live: sk_live_...)
# NIEMALS im Frontend-JS oder im Git ablegen!
STRIPE_SECRET_KEY=sk_test_XXXX

# Webhook-Signatur aus dem Stripe-Dashboard (Developers -> Webhooks -> Endpoint)
# Wird zwingend gebraucht, damit der Server Zahlungsbestätigungen prüfen kann.
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# Domain des Shops (bei Lokalbetrieb ohne /server)
DOMAIN=http://localhost:5000

# Port des Backends
PORT=5000

# SQLite-Datenbank (Standard: server/shop.db)
IRM_DB_PATH=

# Admin-Zugang (wird beim Start automatisch angelegt)
IRM_ADMIN_USERNAME=admin
IRM_ADMIN_PASSWORD=einSicherersPasswort

# E-Mail-Versand (optional; ohne diese Werte werden Mails übersprungen)
ADMIN_EMAIL=info@irmgaertchen.de
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
